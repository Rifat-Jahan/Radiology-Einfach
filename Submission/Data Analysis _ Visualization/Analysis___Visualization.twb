      <table>
        <view>
          <datasources>
            <datasource caption='All Investigation (Patient Examination Data_eng)' name='federated.04u0ai90nss1e615brzkk1bc7uio' />
          </datasources>
          <datasource-dependencies datasource='federated.04u0ai90nss1e615brzkk1bc7uio'>
            <column datatype='integer' name='[Appointment ID (Schedule to St)]' role='dimension' type='ordinal' />
            <column caption='Diff_Min' datatype='integer' name='[Calculation_716353864894369793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;,[Start of appointment],[Deadline])' />
            </column>
            <column caption='Time Diff in Sec' datatype='integer' name='[Calculation_716353864895025154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[Start of appointment],[Deadline])' />
            </column>
            <column caption='Days' datatype='real' name='[Calculation_716353864903852050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_716353864895025154])-(SUM([Calculation_716353864895025154])%(24*3600)))/(24*3600)' />
            </column>
            <column caption='Hours' datatype='real' name='[Calculation_716353864904118291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([Calculation_716353864895025154])%(24*3600)))-&#13;&#10;(SUM([Calculation_716353864895025154])%(24*3600))%3600)/3600' />
            </column>
            <column caption='Minutes' datatype='real' name='[Calculation_716353864904445972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([Calculation_716353864895025154])%(24*3600))%3600)-&#13;&#10;((SUM([Calculation_716353864895025154])%(24*3600))%3600)%60)/60' />
            </column>
            <column caption='Seconds' datatype='integer' name='[Calculation_716353864904765461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([Calculation_716353864895025154])%(24*3600))%3600)%60' />
            </column>
            <column caption='Appointment Times Difference' datatype='string' name='[Calculation_716353864904933398]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_716353864903852050]&gt;0 THEN&#13;&#10;&#13;&#10;STR([Calculation_716353864903852050])+&quot; Day&quot;+&quot; &quot; +&#13;&#10;STR([Calculation_716353864904118291])+&quot; Hr&quot;+&quot; &quot; +&#13;&#10;STR([Calculation_716353864904445972])+&quot; Min&quot; +&quot; &quot; +&#13;&#10;STR([Calculation_716353864904765461])+&quot; Sec&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;STR([Calculation_716353864904118291])+&quot; Hr&quot;+ &quot; &quot; +&#13;&#10;STR([Calculation_716353864904445972])+&quot; Min&quot;+ &quot; &quot; +&#13;&#10;STR([Calculation_716353864904765461])+&quot; Sec&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='datetime' name='[Deadline]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[Start of appointment]' role='dimension' type='ordinal' />
            <column-instance column='[Appointment ID (Schedule to St)]' derivation='None' name='[none:Appointment ID (Schedule to St):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Deadline]' derivation='None' name='[none:Deadline:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Start of appointment]' derivation='None' name='[none:Start of appointment:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_716353864894369793]' derivation='Sum' name='[sum:Calculation_716353864894369793:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_716353864904933398]' derivation='User' name='[usr:Calculation_716353864904933398:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <_.fcp.SingleValuePerNestSorting.true...single-value-per-nest-shelf-sorts>
            <single-value-per-nest-shelf-sort dimension-to-sort='[federated.04u0ai90nss1e615brzkk1bc7uio].[none:Appointment ID (Schedule to St):ok]' direction='ASC' measure-to-sort-by='[federated.04u0ai90nss1e615brzkk1bc7uio].[none:Start of appointment:ok]' shelf='rows' />
          </_.fcp.SingleValuePerNestSorting.true...single-value-per-nest-shelf-sorts>
